# WalletConnect Project ID for RainbowKit
# Get your project ID from https://cloud.walletconnect.com
VITE_WALLETCONNECT_PROJECT_ID=your_project_id_here

# Network: 'mainnet' for Celo Mainnet, 'testnet' (or any other value) for Celo Sepolia
VITE_NETWORK=testnet

# Chainstack RPC for Celo Mainnet (optional - overrides default forno.celo.org)
# Get your endpoint from chainstack.com (Growth plan with AGENTSATWORK coupon)
VITE_MAINNET_RPC_URL=https://celo-mainnet.core.chainstack.com/6731263347ccc0c06dc47652f9069d42

# Backend API URL (for production deployments)
# In development, Vite proxies /scan to localhost:3000
# In production, set this to your Railway backend URL (e.g., https://your-app.railway.app)
VITE_API_URL=https://your-railway-backend-url.railway.app
